{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zyzoom Download Manager",
  "version": "1.0.0",
  "identifier": "com.zyzoom.zdm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zyzoom Download Manager (ZDM) • Developed by Ramy Badraan",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Ramy Badraan. All rights reserved."
  }
}
