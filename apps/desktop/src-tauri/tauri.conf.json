{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zyzoom Download Manager",
  "version": "1.0.0",
  "identifier": "com.zyzoom.zdm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zyzoom Download Manager (ZDM) • Developed by Ramy Badraan",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Ramy Badraan. All rights reserved.",
    "category": "Network",
    "shortDescription": "Turbo Multi-Segment Download Accelerator",
    "longDescription": "Zyzoom Download Manager (ZDM) - High-Performance Download Accelerator with dynamic multi-range direct disk writing, video sniffer, and browser integration. Developed by Ramy Badraan.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "sidebarImage": "icons/icon.png",
        "installMode": "both",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1"
        ],
        "section": "net"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
