{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zyzoom Download Manager",
  "version": "1.3.0",
  "identifier": "com.zyzoom.zdm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zyzoom Download Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/32x32.png",
      "tooltip": "Zyzoom Download Manager"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../extension": "extension",
      "../../../assets/logo.svg": "logo.svg"
    },
    "copyright": "Copyright \u00a9 2026 Ramy Badraan. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Multi-segment download accelerator",
    "longDescription": "Zyzoom Download Manager (ZDM) \u2014 a multi-segment download accelerator with a real pause/resume engine, browser capture and a video downloader. Developed by Ramy Badraan.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128@2x.png",
        "sidebarImage": "icons/icon.png",
        "installMode": "perMachine",
        "languages": [
          "English",
          "Arabic",
          "French"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "en-US",
          "ar-SA",
          "fr-FR"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "net",
        "files": {}
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzOEFDNDQ2RjI4Q0Y5RTcKUldUbitZenlSc1NLcytoTG84c1pSRXl5SHJuT0pQMDQ5WjNKT0sxQWNLMFBQZ0VocEt1L3hkRWkK",
      "endpoints": [
        "https://github.com/ramybadraan11-del/zdm-releases/releases/latest/download/latest.json"
      ]
    }
  }
}